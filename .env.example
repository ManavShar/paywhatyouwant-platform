# Copy to .env and fill in. .env is gitignored.

# --- Database -------------------------------------------------------------
# Points at the Docker Compose service (host port 5433, to avoid colliding
# with the native PostgreSQL 18 install on 5432).
DATABASE_URL="postgresql://pwyw:pwyw_dev_password@localhost:5433/pwyw?schema=public"

# --- Auth -----------------------------------------------------------------
# Generate with: npx auth secret
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# --- Stripe (test mode) ---------------------------------------------------
# From https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
# From `stripe listen --forward-to localhost:3000/api/stripe/webhook`
STRIPE_WEBHOOK_SECRET="whsec_..."
# Platform commission on each sale, as a percentage.
PLATFORM_FEE_PERCENT="10"

# --- Storage --------------------------------------------------------------
# Local filesystem in development. Swap for S3-compatible storage later.
STORAGE_DRIVER="local"
STORAGE_LOCAL_PATH="./storage"

# --- App ------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Private preview gate. Set both to put the whole site behind HTTP Basic auth;
# leave PREVIEW_PASSWORD unset and the gate is inactive (local development).
PREVIEW_USERNAME=preview
PREVIEW_PASSWORD=

# --- Email ----------------------------------------------------------------
# Receipts and purchase-recovery links. Until one of these is set, mail is
# written to `storage/outbox/` as files and logged instead of being sent —
# nothing is silently dropped, but nothing reaches a buyer either, so this is
# the last thing to configure before real customers use the site.
#
# Either a single URL:
#   SMTP_URL="smtps://user:password@smtp.example.com:465"
# or the parts:
SMTP_URL=
SMTP_HOST=
SMTP_PORT="587"
SMTP_USER=
SMTP_PASSWORD=
# What buyers see in the From line.
MAIL_FROM="Paywhatyouwant.io <info@paywhatyouwant.io>"
